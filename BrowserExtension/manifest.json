{
  "manifest_version": 3,
  "name": "LocalPrompt Slides",
  "version": "0.4.0.2",
  "description": "Connect one Google Slides slideshow to LocalPrompt on this Mac.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "LocalPrompt Slides",
    "default_popup": "popup.html"
  }
}
